{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://camera-pihq.onrender.com/api/$1"
    },
    {
      "source": "/auth/google/(.*)",
      "destination": "https://camera-pihq.onrender.com/auth/google/$1"
    },
    {
      "source": "/storage/(.*)",
      "destination": "https://camera-pihq.onrender.com/storage/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
